node_modules/
# run captures + generated video artifacts — regenerable from code (seeded demos),
# 775M+ of mp4s would bloat the repo. captureClip / integrate.mjs rebuilds any clip.
web/site/clips/
engine/state/runs/*/capture/
engine/night/logs/
engine/state/certs/
# per-run events — regenerable via `node engine/loop.mjs report`
engine/state/runs/
engine/state/analytics/
# distribution loop working state — contains third-party usernames, post bodies and
# unsent draft outreach. This repo is PUBLIC and auto-pushes; none of that belongs in it.
# (engine/state/channels.json IS tracked — it's our own registry, no personal data.)
engine/state/distribution/
.DS_Store
.vercel
.env*
